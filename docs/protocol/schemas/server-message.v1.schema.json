{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrtc.dev/schemas/protocol/server-message.v1.schema.json",
  "title": "OpenRTC v1 Server Messages",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "payload"],
      "properties": {
        "t": { "const": "HELLO" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conn_id", "server"],
          "properties": {
            "conn_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "server": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "node_id"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "node_id": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "payload"],
      "properties": {
        "t": { "const": "ERROR" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 },
            "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "room": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^[a-zA-Z0-9._:-]+$"
            },
            "document": {},
            "sequence": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "room", "payload"],
      "properties": {
        "t": { "const": "JOINED" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["members", "presence"],
          "properties": {
            "members": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "presence": {
              "type": "object",
              "additionalProperties": true
            },
            "next_cursor": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "room"],
      "properties": {
        "t": { "const": "LEFT" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "room", "event", "payload"],
      "properties": {
        "t": { "const": "EVENT" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "event": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payload": {},
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trace_id": { "type": "string" },
            "seq": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "room", "payload"],
      "properties": {
        "t": { "const": "PRESENCE" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "required": ["conn_id"],
          "properties": {
            "conn_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "state": {},
            "offline": { "type": "boolean" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "room", "payload"],
      "properties": {
        "t": { "const": "STORAGE_SNAPSHOT" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document"],
          "properties": {
            "document": {}
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seq": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "room", "payload"],
      "properties": {
        "t": { "const": "STORAGE_ACK" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document"],
          "properties": {
            "kind": { "enum": ["set", "patch"] },
            "op_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "document": {}
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seq": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "room", "payload"],
      "properties": {
        "t": { "const": "STORAGE_UPDATE" },
        "room": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["set", "patch", "delete"] },
            "op_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "origin_conn_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "seq": { "type": "integer", "minimum": 1 },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["op", "path"],
                "properties": {
                  "op": { "type": "string" },
                  "path": { "type": "string" },
                  "from": { "type": "string" },
                  "value": {}
                }
              }
            },
            "document": {}
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seq": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
